{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDD contract v1",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "source_kind": {
          "enum": [
            "core_json",
            "interface_json",
            "manual",
            "synthetic"
          ]
        },
        "table": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100000
        },
        "extracted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dictionary_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "query_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "source_kind",
        "table",
        "key",
        "fields",
        "extracted_at",
        "dictionary_version",
        "query_version"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "query_status": {
          "enum": [
            "succeeded",
            "not_queried",
            "failed",
            "permission_denied",
            "not_provided"
          ]
        },
        "coverage_kind": {
          "enum": [
            "snapshot",
            "history_events",
            "risk_information"
          ]
        },
        "from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "query_status",
        "coverage_kind",
        "from",
        "to",
        "as_of",
        "complete",
        "note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "query_status": {
                "not": {
                  "const": "succeeded"
                }
              }
            }
          },
          "then": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "snapshot_type": {
          "enum": [
            "policy",
            "product",
            "duty",
            "premium_plan",
            "benefit",
            "policy_state",
            "policy_extension"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "fact_id",
        "snapshot_type",
        "source",
        "values"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "policyholder",
              "insured",
              "beneficiary"
            ]
          },
          "maxItems": 100000,
          "minItems": 1,
          "uniqueItems": true
        },
        "subject_match": {
          "enum": [
            "confirmed",
            "unconfirmed"
          ]
        },
        "one_year_product": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "business_type": {
          "type": "string",
          "minLength": 1
        },
        "event_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "completed",
            "pending",
            "cancelled",
            "reversed",
            "unknown"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_kind": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "customer_to_company",
                "company_to_customer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "payment_method": {
          "enum": [
            "cash",
            "bank_transfer",
            "other",
            "unknown"
          ]
        },
        "claim_channel": {
          "anyOf": [
            {
              "enum": [
                "individual",
                "group",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "fact_id",
        "source_record_id",
        "policy_id",
        "customer_id",
        "roles",
        "subject_match",
        "one_year_product",
        "business_type",
        "event_time",
        "status",
        "amount",
        "amount_kind",
        "currency",
        "direction",
        "payment_method",
        "claim_channel",
        "source"
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "type": {
          "enum": [
            "judicial",
            "blacklist",
            "negative_information",
            "suspicious_report",
            "large_transaction_report",
            "risk_grade",
            "risk_grade_change",
            "other"
          ]
        },
        "event_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_match": {
          "enum": [
            "confirmed",
            "unconfirmed"
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "fact_id",
        "type",
        "event_time",
        "subject_match",
        "facts",
        "source"
      ],
      "additionalProperties": false
    },
    "excerpt": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "confirmed": {
          "type": "boolean"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "fact_id",
        "text",
        "confirmed",
        "confirmed_at",
        "attachment_id",
        "source"
      ],
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "properties": {
        "conflict_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "candidate_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "resolved": {
          "type": "boolean"
        },
        "adopted_fact_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "conflict_id",
        "field",
        "candidate_fact_ids",
        "resolved",
        "adopted_fact_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resolved": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "adopted_fact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S+$"
              }
            }
          },
          "else": {
            "properties": {
              "adopted_fact_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "synthetic": {
          "type": "boolean"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "analysis_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "parent_analysis_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            "display_name": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 20000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "customer_id",
            "display_name"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "policy_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "role": {
              "enum": [
                "policyholder",
                "insured",
                "beneficiary"
              ]
            },
            "trigger": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "policy_id",
            "role",
            "trigger"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/coverage"
          }
        },
        "core_snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot"
          },
          "maxItems": 100000
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "maxItems": 100000
        },
        "risk_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          },
          "maxItems": 100000
        },
        "manual_excerpts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excerpt"
          },
          "maxItems": 100000
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attachment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S+$"
              },
              "description": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "attachment_id",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          },
          "maxItems": 100000
        },
        "rule_context": {
          "type": "object",
          "properties": {
            "rule_package_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "rule_package_id",
            "expected_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "snapshot_id",
        "analysis_as_of",
        "parent_analysis_id",
        "subject",
        "context",
        "coverage",
        "core_snapshots",
        "events",
        "risk_records",
        "manual_excerpts",
        "attachments",
        "conflicts",
        "rule_context"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "INVALID_JSON",
                "UNSUPPORTED_SCHEMA_VERSION",
                "INVALID_REQUEST",
                "INVALID_REFERENCE",
                "DUPLICATE_ID",
                "UNAUTHORIZED",
                "FORBIDDEN",
                "NOT_FOUND",
                "IDEMPOTENCY_CONFLICT",
                "PAYLOAD_TOO_LARGE",
                "QUEUE_FULL",
                "RESULT_NOT_READY",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 20000
            },
            "details": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/issue"
              },
              "maxItems": 100000
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "error"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "fact_id",
        "source"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "maxItems": 100000
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "maxItems": 100000
        }
      },
      "required": [
        "section",
        "text",
        "fact_refs",
        "rule_refs"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "grain": {
          "type": "string",
          "minLength": 1
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "maxItems": 100000
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "currency_code",
        "currency_label",
        "grain",
        "fact_refs"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "suggestion",
            "insufficient_rules",
            "insufficient_evidence",
            "requires_institution_review",
            "not_applicable"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 20000
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "maxItems": 100000
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "maxItems": 100000
        }
      },
      "required": [
        "status",
        "value",
        "reason",
        "fact_refs",
        "rule_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "suggestion"
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "grade": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "suggestion",
            "insufficient_rules",
            "insufficient_evidence",
            "requires_institution_review",
            "not_applicable"
          ]
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "highest"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 20000
        },
        "fact_refs": {
          "type": "array",
