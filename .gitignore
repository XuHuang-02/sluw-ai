# Build products and local vendor runtime
**/target/
/install/
/appserver/
/ext-lib/
*.class
*.jar
*.war
*.zip
*.log
*.lic

# IDE and machine-specific files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
__pycache__/

# Credentials and real environment configuration
.env
.env.*
!.env.example
local-settings.properties
/src/main/resources/application-dev.yml
/src/main/resources/application-test.yml
/src/main/resources/application-prod.yml
*.pem
*.key
*.p12
*.pfx

# Documents describing requirements are versioned; downloaded tools/cache are not.
/.scratch/*
!/.scratch/policy-problem-assessment/
!/.scratch/chat-issue-review/
/.scratch/chat-issue-review/*
!/.scratch/chat-issue-review/spec.md
/.scratch/policy-problem-assessment/**/backups/

# Uploaded policy data and local run data
**/assessment-data/
**/uploads/
**/logs/
**/*.hprof

# Local test sources (keep test-environment deployment scripts versioned)
/test/
/src/test/

# Additional local build, editor and temporary files
/out/
/build/
/tmp/
/temp/
.classpath
.project
.settings/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
node_modules/
.pytest_cache/
.venv/

# Local routing evaluation journals (may contain business report references)
/routing-eval-runs/

# Version the EDD adapter regression tests without exposing other local test data.
!/src/test/
/src/test/*
!/src/test/java/
/src/test/java/*
!/src/test/java/com/
/src/test/java/com/*
!/src/test/java/com/sinosig/
/src/test/java/com/sinosig/*
!/src/test/java/com/sinosig/sluw/
/src/test/java/com/sinosig/sluw/*
!/src/test/java/com/sinosig/sluw/application/
/src/test/java/com/sinosig/sluw/application/*
!/src/test/java/com/sinosig/sluw/application/edd/

# Direct risk-overview chat regressions; other local tests remain private.
!/src/test/java/com/sinosig/sluw/application/service/
/src/test/java/com/sinosig/sluw/application/service/*
!/src/test/java/com/sinosig/sluw/application/service/RiskOverviewChatTest.java
!/src/test/java/com/sinosig/sluw/application/controller/
/src/test/java/com/sinosig/sluw/application/controller/*
!/src/test/java/com/sinosig/sluw/application/controller/IssueSubmissionRoutingTest.java
